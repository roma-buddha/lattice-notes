{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Notus",
  "version": "0.3.0",
  "identifier": "app.notus.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Notus",
        "width": 1280,
        "height": 840,
        "minWidth": 680,
        "minHeight": 520,
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "shortDescription": "A quiet place for your notes.",
    "category": "Productivity",
    "windows": {
      "nsis": { "installMode": "currentUser", "compression": "lzma" }
    }
  }
}
